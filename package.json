{
  "name": "sandbox",
  "version": "1.0.0",
  "description": "Express webhook receiver with HMAC verification and durable deduplication",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/server.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "webhook",
    "express",
    "hmac"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.3",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "typescript": "^7.0.2"
  }
}
